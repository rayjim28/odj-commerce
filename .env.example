# Local development settings. Generated .env files and live credentials are private.
APP_ENV=development
PAYMENT_MODE=demo
DATABASE_URL=
MEDIA_DIR=
PUBLIC_BASE_URL=
SESSION_SECRET=
ADMIN_PASSWORD_HASH=

# Stripe. For test-mode integrations use only isolated test keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# Production launch controls. See LAUNCH_HANDOFF.md.
SALES_ENABLED=false
TAX_REGISTRATIONS_REVIEWED=false
SHIPPING_RATES_APPROVED=false
PUBLIC_STOREFRONT=false
PUBLIC_ACCOUNT_TESTING=false
ACCOUNT_TEST_EMAIL=

# Email delivery uses scripts/send_notifications.py in a scheduled job.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
